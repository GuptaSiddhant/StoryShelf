{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.nub/bin:$PATH\" && cd apps/website && nub run dev -- --port 4321"],
      "port": 4321
    },
    {
      "name": "app",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.nub/bin:$PATH\" && nub run serve"],
      "port": 3000
    }
  ]
}
