{
  "name": "dev-server",
  "private": true,
  "description": "Local StoryShelf dev server, run from TypeScript source (no build step) via nub + customCondition.",
  "type": "module",
  "scripts": {
    "serve": "nub watch ./src/server.ts",
    "lint": "oxlint --type-aware --type-check ./src",
    "fmt": "oxfmt ./src",
    "build": "nubx tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@storyshelf/app": "workspace:*",
    "@storyshelf/auth": "workspace:*",
    "@storyshelf/core": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/notify-chat": "workspace:*",
    "@storyshelf/notify-email": "workspace:*",
    "@storyshelf/observability": "workspace:*",
    "@storyshelf/runner-playwright": "workspace:*",
    "@storyshelf/storage-local": "workspace:*",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
