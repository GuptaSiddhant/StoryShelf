# syntax=docker/dockerfile:1
# SPIKE (#821): the Fly image without nub or `turbo prune`. `pnpm install --filter fly-app...` installs
# only fly-app and the workspace packages it depends on, from the root pnpm-lock.yaml.
# Build context is the repo root, as for the nub Dockerfile.
FROM node:24-bookworm-slim AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm i -g pnpm@12.18.0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY config ./config
COPY packages ./packages
COPY apps ./apps
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter 'fly-app...'
RUN pnpm exec rolldown -c apps/fly-app/rolldown.config.ts

FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=builder /app/apps/fly-app/dist ./dist
COPY --from=builder /app/apps/fly-app/package.json ./package.json
COPY --from=builder /app/apps/fly-app/migrate-to-s3.sh ./migrate-to-s3.sh
COPY --from=builder /app/node_modules ./node_modules
RUN node node_modules/playwright-core/cli.js install --with-deps --only-shell chromium
ENV NODE_ENV=production
ENV PORT=3000
ENV DATA_DIR=/data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.mjs"]
