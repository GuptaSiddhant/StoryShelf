{
  "name": "fly-app",
  "private": true,
  "description": "StoryShelf Fly demo server (local adapters, workspace versions).",
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "start": "node dist/server.mjs",
    "lint": "oxlint --type-aware --type-check server.ts ai.ts ai.test.ts vitest.config.ts sprite.ts sprite.test.ts storage.ts storage.test.ts migrate.ts migrate.test.ts migrate-to-s3.ts e2e/golden-path.test.ts && oxlint sprite",
    "test": "vitest run",
    "test:e2e": "STORYSHELF_E2E=1 vitest run e2e/golden-path.test.ts",
    "dev": "node --conditions=source --experimental-transform-types server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.76",
    "@hono/node-server": "catalog:",
    "@storyshelf/ai": "workspace:*",
    "@storyshelf/app": "workspace:*",
    "@storyshelf/auth": "workspace:*",
    "@storyshelf/core": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/design-figma": "workspace:*",
    "@storyshelf/notify-chat": "workspace:*",
    "@storyshelf/notify-email": "workspace:*",
    "@storyshelf/notify-git": "workspace:*",
    "@storyshelf/observability": "workspace:*",
    "@storyshelf/runner-playwright": "workspace:*",
    "@storyshelf/storage-local": "workspace:*",
    "@storyshelf/storage-s3": "workspace:*",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright-core": "1.63.0",
    "rolldown": "*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
