{
  "name": "fly-app",
  "private": true,
  "description": "StoryShelf Fly demo server (local adapters, workspace versions).",
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "start": "node dist/bin.mjs serve",
    "lint": "oxlint --type-aware --type-check instance.ts ai.ts ai.test.ts vitest.config.ts sprite.ts sprite.test.ts storage.ts storage.test.ts migrate.ts migrate.test.ts migrate-to-s3.ts e2e/golden-path.test.ts demo-viewer.ts demo-viewer-db.ts demo-viewer.test.ts && oxlint sprite",
    "test": "vitest run",
    "test:e2e": "SHELF_E2E=1 vitest run e2e/golden-path.test.ts",
    "dev": "node --conditions=source --experimental-transform-types ../../packages/app/src/server-bin/bin.ts serve --entry instance.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.76",
    "@storyshelf/ai": "workspace:*",
    "@storyshelf/app": "workspace:*",
    "@storyshelf/auth": "workspace:*",
    "@storyshelf/core": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/observability": "workspace:*",
    "@storyshelf/runner": "workspace:*",
    "@storyshelf/storage": "workspace:*",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright-core": "1.63.0",
    "rolldown": "*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "storyshelf": {
    "server": "dist/instance.mjs"
  }
}
