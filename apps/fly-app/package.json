{
  "name": "fly-app",
  "private": true,
  "type": "module",
  "description": "StoryShelf Fly demo server (local adapters, workspace versions).",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "start": "node dist/server.mjs",
    "dev": "node --conditions=source --experimental-transform-types server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.0",
    "@storyshelf/auth-password": "workspace:*",
    "@storyshelf/core": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/runner-playwright": "workspace:*",
    "@storyshelf/storage-local": "workspace:*"
  }
}
