{
  "name": "server-image",
  "private": true,
  "description": "StoryShelf product container image: an env-configured server, published on each stable release.",
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "start": "node dist/bin.mjs serve",
    "lint": "oxlint --type-aware --type-check instance.ts env.ts env.test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.0.0",
    "@storyshelf/app": "workspace:*",
    "@storyshelf/auth": "workspace:*",
    "@storyshelf/core": "workspace:*",
    "@storyshelf/db": "workspace:*",
    "@storyshelf/observability": "workspace:*",
    "@storyshelf/runner": "workspace:*",
    "@storyshelf/storage": "workspace:*",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rolldown": "*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "storyshelf": {
    "server": "dist/instance.mjs"
  }
}
