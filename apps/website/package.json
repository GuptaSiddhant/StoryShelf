{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-changelog.mjs",
    "openapi": "nub ../../packages/app/scripts/generate-openapi.ts --out ./public/openapi.json",
    "prebuild": "nub run openapi && nub run sync",
    "predev": "nub run openapi && nub run sync",
    "dev": "astro dev",
    "start": "astro preview",
    "build": "astro build && node scripts/markdown-export.mjs",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "verify": "nub run check:links"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.34.0",
    "astro": "^5.7.0",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^12.0.0",
    "sharp": "^0.35.5",
    "starlight-image-zoom": "0.13.2",
    "starlight-links-validator": "0.19.2",
    "starlight-openapi": "0.22.1",
    "starlight-package-managers": "0.13.0"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "hast-util-select": "6.0.4",
    "playwright-core": "1.63.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "starlight-typedoc": "0.21.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "5.9.3",
    "unified": "11.0.5"
  }
}
