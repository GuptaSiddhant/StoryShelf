---
/**
 * App screenshot with light/dark variants (src/assets/screenshots/<name>-{light,dark}.png,
 * regenerated by `nub run screenshots`). Astro optimises both to responsive webp; CSS in
 * custom.css shows the one matching the site theme. Click-to-zoom comes from
 * starlight-image-zoom.
 */
import { Image } from "astro:assets";

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", {
  eager: true,
});
const light = images[`../assets/screenshots/${name}-light.png`]?.default;
const dark = images[`../assets/screenshots/${name}-dark.png`]?.default;
if (!light || !dark) {
  throw new Error(`Screenshot "${name}" needs ${name}-light.png and ${name}-dark.png in src/assets/screenshots`);
}
const widths = [640, 960, 1280, 1920];
const sizes = "(min-width: 50rem) 46rem, 100vw";
---

<figure class="screenshot">
  <Image class="light-only" src={light} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  <Image class="dark-only" src={dark} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
