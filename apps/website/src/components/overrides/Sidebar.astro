---
/**
 * Two menus in one sidebar: the generated HTTP API reference gets its own (reached from the
 * header "HTTP API" link), and the docs menu only carries a single link to it. The generated
 * TypeScript API lives inside the docs menu, under each package.
 */
import Default from "@astrojs/starlight/components/Sidebar.astro";

const route = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const onApi = Astro.url.pathname.startsWith(`${base}/api`);
const isApiGroup = (e: (typeof route.sidebar)[number]) => e.type === "group" && e.label === "HTTP API";
const link = (label: string, href: string) => ({
  type: "link" as const,
  label,
  href,
  isCurrent: false,
  badge: undefined,
  attrs: {},
});

const back = link("← Back to docs", `${base}/guides/getting-started/`);

if (onApi) {
  route.sidebar = [back, ...route.sidebar.filter(isApiGroup)];
} else {
  route.sidebar = route.sidebar.map((e) => (isApiGroup(e) ? link("HTTP API", `${base}/api/`) : e));
}
---

<Default {...Astro.props}><slot /></Default>
