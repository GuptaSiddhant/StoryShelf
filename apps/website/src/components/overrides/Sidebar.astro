---
/**
 * Three menus in one sidebar: the generated HTTP API reference and the generated TypeScript
 * reference each get their own, and the docs menu only carries a single link to each.
 */
import Default from "@astrojs/starlight/components/Sidebar.astro";

const route = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const onApi = Astro.url.pathname.startsWith(`${base}/api`);
const onReference = Astro.url.pathname.startsWith(`${base}/reference`);
const isApiGroup = (e: (typeof route.sidebar)[number]) => e.type === "group" && e.label === "API reference";
const link = (label: string, href: string) => ({
  type: "link" as const,
  label,
  href,
  isCurrent: false,
  badge: undefined,
  attrs: {},
});

const isReferenceGroup = (e: (typeof route.sidebar)[number]) =>
  e.type === "group" && e.label === "TypeScript reference";
const back = link("← Back to docs", `${base}/guides/getting-started/`);

if (onApi) {
  route.sidebar = [back, ...route.sidebar.filter(isApiGroup)];
} else if (onReference) {
  route.sidebar = [back, ...route.sidebar.filter(isReferenceGroup)];
} else {
  route.sidebar = route.sidebar.map((e) => {
    if (isApiGroup(e)) return link("API reference", `${base}/api/`);
    if (isReferenceGroup(e)) return link("TypeScript reference", `${base}/reference/core/`);
    return e;
  });
}
---

<Default {...Astro.props}><slot /></Default>
