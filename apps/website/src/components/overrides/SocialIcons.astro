---
/** Header: text links to the docs, the packages and the HTTP API, then Starlight's social icons. */
import Default from "@astrojs/starlight/components/SocialIcons.astro";

import { sectionLinks, sectionOf } from "./sections";

const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const section = sectionOf(Astro.url.pathname, base);
const links = sectionLinks(base);
---

<nav class="header-links" aria-label="Main">
  {
    links.map((l) => (
      <a href={l.href} aria-current={l.section === section ? "page" : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>
<Default {...Astro.props}><slot /></Default>

<style is:global>
  .header-links {
    display: flex;
    gap: 1.25rem;
    margin-inline-end: 0.5rem;
  }
  .header-links a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .header-links a:hover,
  .header-links a[aria-current="page"] {
    color: var(--sl-color-white);
  }
  /* The mobile menu footer reuses this slot; the links sit above the menu there instead. */
  .mobile-preferences .header-links {
    display: none;
  }
</style>
