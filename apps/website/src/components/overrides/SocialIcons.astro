---
/** Header: text links to the docs and API reference, then Starlight's social icons. */
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const path = Astro.url.pathname;
const onApi = path.startsWith(`${base}/api`);
const links = [
  { label: "Docs", href: `${base}/guides/getting-started/`, current: !onApi },
  { label: "API", href: `${base}/api/`, current: onApi },
];
---

<nav class="header-links" aria-label="Main">
  {links.map((l) => <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
</nav>
<Default {...Astro.props}><slot /></Default>

<style>
  .header-links {
    display: flex;
    gap: 1.25rem;
    margin-inline-end: 0.5rem;
  }
  .header-links a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .header-links a:hover,
  .header-links a[aria-current="page"] {
    color: var(--sl-color-white);
  }
</style>
