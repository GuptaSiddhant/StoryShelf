{
  "$schema": "https://nubjs.com/schema/latest.json",
  "conditions": ["source"],
  "install": {
    "linker": { "strategy": "isolated" },
    "publicHoist": [
      "@types/*",
      "@hono/*",
      "hono",
      "pino",
      "drizzle-orm",
      "zod",
      "pixelmatch",
      "pngjs",
      "adm-zip",
      "better-sqlite3",
      "playwright",
      "yaml",
    ],
  },
}
