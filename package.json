{
  "name": "storyshelf-monorepo",
  "private": true,
  "description": "Self-hosted visual testing platform for Storybook.",
  "license": "MIT",
  "author": "Siddhant Gupta <guptasiddhant@icloud.com>",
  "repository": "git@github.com:GuptaSiddhant/storyshelf.git",
  "workspaces": {
    "packages": ["./packages/*", "apps/*"],
    "catalog": {
      "@types/node": "^26.0.0",
      "@vitest/coverage-v8": "^4.0.0",
      "oxfmt": "^0.65.0",
      "oxlint": "^1.80.0",
      "oxlint-tsgolint": "^7.0.2001",
      "typescript": "^7.0.2",
      "tsdown": "^0.22.14",
      "vitest": "^4.0.0",
      "pino": "^10.3.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:pkg": "turbo build --filter='./packages/*'",
    "core:build": "nub run --filter @storyshelf/core build",
    "core:dev": "nub run --filter @storyshelf/core dev",
    "cli": "nub run --filter @storyshelf/cli start",
    "docs": "nub run --filter website start",
    "serve": "nub run --filter dev-server serve",
    "fmt": "turbo fmt",
    "lint": "turbo lint",
    "test": "turbo test",
    "audit": "turbo audit",
    "verify": "turbo verify --filter='./packages/*' --filter='website'",
    "web:build": "nub run --filter website build",
    "web:dev": "nub run --filter website dev",
    "release": "nub ./scripts/release.mjs",
    "release:dry": "nub ./scripts/release.mjs --dry-run",
    "trust": "node ./scripts/npm-trust-all.mjs"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "*",
    "tsdown": "catalog:",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    },
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "error"
    }
  },
  "allowBuilds": {
    "better-sqlite3": true
  }
}
