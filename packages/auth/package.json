{
  "name": "@storyshelf/auth",
  "version": "0.9.0",
  "description": "Better Auth engine for StoryShelf: opaque DBAdapter bridge, shelf factory, and auth presets.",
  "keywords": [
    "auth",
    "better-auth",
    "self-hosted",
    "storybook"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack -w",
    "fmt": "vp fmt ./src",
    "lint": "vp lint --type-aware --type-check ./src",
    "test": "vp test run",
    "prepublishOnly": "nub run build",
    "test:flake": "vp test run --repeats=10 --maxWorkers=1 --no-file-parallelism src/engine.test.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@storyshelf/core": "workspace:*",
    "better-auth": "1.7.14",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@storyshelf/db-postgres": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
