{
  "name": "@storyshelf/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "StoryShelf CLI: create projects, upload builds, purge, and retry from CI.",
  "license": "MIT",
  "bin": {
    "storyshelf": "./dist/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt -c ../../.oxfmtrc.json ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "start": "nub --watch ./dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "commander": "^13.0.0",
    "hono": "^4.11.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@storyshelf/core": "workspace:*"
  }
}
