{
  "name": "@storyshelf/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "StoryShelf CLI: run the server, create projects, upload builds.",
  "license": "MIT",
  "bin": {
    "storyshelf": "./dist/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt -c ../../.oxfmtrc.json ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.0",
    "@storyshelf/core": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/storage-local": "workspace:*",
    "adm-zip": "^0.6.0",
    "commander": "^13.0.0",
    "hono": "^4.11.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
