{
  "name": "@storyshelf/cli",
  "version": "0.1.3",
  "description": "StoryShelf CLI: create projects, upload builds, purge, and retry from CI.",
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/cli"
  },
  "bin": {
    "storyshelf": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "start": "nub --watch ./dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "nub run build"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "commander": "^13.0.0",
    "hono": "^4.11.0",
    "picomatch": "^4.0.2",
    "prompts": "^2.4.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@storyshelf/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.1",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "jsr": {
    "runtimeCompat": {
      "node": true,
      "deno": true,
      "browser": false,
      "workerd": false,
      "bun": true
    }
  }
}
