{
  "name": "storyshelf",
  "version": "0.10.0",
  "description": "StoryShelf CLI: create projects, upload builds, purge, and retry from CI.",
  "keywords": [
    "ci",
    "cli",
    "self-hosted",
    "storybook",
    "visual-testing"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/cli"
  },
  "bin": {
    "storyshelf": "dist/index.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack -w",
    "fmt": "vp fmt ./src",
    "lint": "vp lint --type-aware --type-check ./src",
    "start": "nub --watch ./dist/index.js",
    "prepublishOnly": "nub run build",
    "test:flake": "vp test run --repeats=20 --maxWorkers=1 --no-file-parallelism src/output.test.ts"
  },
  "dependencies": {
    "@storyshelf/affected": "workspace:*",
    "archiver": "8.0.0",
    "commander": "^13.0.0",
    "picomatch": "^4.0.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@storyshelf/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/prompts": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "adm-zip": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
