{
  "name": "@storyshelf/core",
  "version": "0.1.1",
  "description": "StoryShelf core: Hono router, adapter interfaces, models, capture pipeline, diff, retention.",
  "homepage": "https://github.com/GuptaSiddhant/storyshelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/storyshelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/storyshelf.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "default": "./dist/index.mjs"
    },
    "./adapter/auth": {
      "source": "./src/adapters/auth.ts",
      "default": "./dist/adapter/auth.mjs"
    },
    "./adapter/capture-runner": {
      "source": "./src/adapters/capture-runner.ts",
      "default": "./dist/adapter/capture-runner.mjs"
    },
    "./adapter/database": {
      "source": "./src/adapters/database.ts",
      "default": "./dist/adapter/database.mjs"
    },
    "./adapter/git-host": {
      "source": "./src/adapters/git-host/index.ts",
      "default": "./dist/adapter/git-host.mjs"
    },
    "./adapter/git-host/helpers": {
      "source": "./src/adapters/git-host/helpers.ts",
      "default": "./dist/adapter/git-host/helpers.mjs"
    },
    "./adapter/storage": {
      "source": "./src/adapters/storage.ts",
      "default": "./dist/adapter/storage.mjs"
    },
    "./ddl": {
      "source": "./src/ddl.ts",
      "default": "./dist/ddl.mjs"
    },
    "./models/baseline": {
      "source": "./src/models/baseline.ts",
      "default": "./dist/models/baseline.mjs"
    },
    "./models/build": {
      "source": "./src/models/build.ts",
      "default": "./dist/models/build.mjs"
    },
    "./models/comment": {
      "source": "./src/models/comment.ts",
      "default": "./dist/models/comment.mjs"
    },
    "./models/label": {
      "source": "./src/models/label.ts",
      "default": "./dist/models/label.mjs"
    },
    "./models/member": {
      "source": "./src/models/member.ts",
      "default": "./dist/models/member.mjs"
    },
    "./models/project": {
      "source": "./src/models/project.ts",
      "default": "./dist/models/project.mjs"
    },
    "./models/snapshot": {
      "source": "./src/models/snapshot.ts",
      "default": "./dist/models/snapshot.mjs"
    },
    "./models/token": {
      "source": "./src/models/token.ts",
      "default": "./dist/models/token.mjs"
    },
    "./models/webhook": {
      "source": "./src/models/webhook.ts",
      "default": "./dist/models/webhook.mjs"
    },
    "./schema": {
      "source": "./src/schema.ts",
      "default": "./dist/schema.mjs"
    },
    "./types": {
      "source": "./src/types.ts",
      "default": "./dist/types.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./adapter/auth": "./dist/adapter/auth.mjs",
      "./adapter/capture-runner": "./dist/adapter/capture-runner.mjs",
      "./adapter/database": "./dist/adapter/database.mjs",
      "./adapter/git-host": "./dist/adapter/git-host.mjs",
      "./adapter/git-host/helpers": "./dist/adapter/git-host/helpers.mjs",
      "./adapter/storage": "./dist/adapter/storage.mjs",
      "./ddl": "./dist/ddl.mjs",
      "./models/baseline": "./dist/models/baseline.mjs",
      "./models/build": "./dist/models/build.mjs",
      "./models/comment": "./dist/models/comment.mjs",
      "./models/label": "./dist/models/label.mjs",
      "./models/member": "./dist/models/member.mjs",
      "./models/project": "./dist/models/project.mjs",
      "./models/snapshot": "./dist/models/snapshot.mjs",
      "./models/token": "./dist/models/token.mjs",
      "./models/webhook": "./dist/models/webhook.mjs",
      "./schema": "./dist/schema.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "lint:fix": "nub run lint -- --fix",
    "prepublishOnly": "nub run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.1.5",
    "adm-zip": "^0.6.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.11.0",
    "pino": "^10.3.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "jsr": {
    "runtimeCompat": {
      "node": true,
      "deno": true,
      "bun": true,
      "workerd": false,
      "browser": false
    }
  }
}
