{
  "name": "@storyshelf/core",
  "version": "0.2.0",
  "description": "StoryShelf core: Hono router, adapter interfaces, models, capture pipeline, diff, retention.",
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "default": "./dist/index.mjs"
    },
    "./adapter/auth": {
      "source": "./src/adapters/auth.ts",
      "default": "./dist/adapter/auth.mjs"
    },
    "./adapter/capture-queue": {
      "source": "./src/adapters/capture-queue.ts",
      "default": "./dist/adapter/capture-queue.mjs"
    },
    "./adapter/capture-runner": {
      "source": "./src/adapters/capture-runner.ts",
      "default": "./dist/adapter/capture-runner.mjs"
    },
    "./adapter/database": {
      "source": "./src/adapters/database.ts",
      "default": "./dist/adapter/database.mjs"
    },
    "./adapter/git-host": {
      "source": "./src/adapters/git-host/index.ts",
      "default": "./dist/adapter/git-host.mjs"
    },
    "./adapter/git-host/comments": {
      "source": "./src/adapters/git-host/comments.ts",
      "default": "./dist/adapter/git-host/comments.mjs"
    },
    "./adapter/git-host/helpers": {
      "source": "./src/adapters/git-host/helpers.ts",
      "default": "./dist/adapter/git-host/helpers.mjs"
    },
    "./adapter/storage": {
      "source": "./src/adapters/storage.ts",
      "default": "./dist/adapter/storage.mjs"
    },
    "./capture": {
      "source": "./src/capture/index.ts",
      "default": "./dist/capture.mjs"
    },
    "./ddl": {
      "source": "./src/ddl.ts",
      "default": "./dist/ddl.mjs"
    },
    "./diff": {
      "source": "./src/diff/index.ts",
      "default": "./dist/diff.mjs"
    },
    "./logger": {
      "source": "./src/logger.ts",
      "default": "./dist/logger.mjs"
    },
    "./paths": {
      "source": "./src/utils/paths.ts",
      "default": "./dist/paths.mjs"
    },
    "./schema": {
      "source": "./src/schema/index.ts",
      "default": "./dist/schema.mjs"
    },
    "./types": {
      "source": "./src/types.ts",
      "default": "./dist/types.mjs"
    },
    "./urls": {
      "source": "./src/urls.ts",
      "default": "./dist/urls.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./adapter/auth": "./dist/adapter/auth.mjs",
      "./adapter/capture-queue": "./dist/adapter/capture-queue.mjs",
      "./adapter/capture-runner": "./dist/adapter/capture-runner.mjs",
      "./adapter/database": "./dist/adapter/database.mjs",
      "./adapter/git-host": "./dist/adapter/git-host.mjs",
      "./adapter/git-host/comments": "./dist/adapter/git-host/comments.mjs",
      "./adapter/git-host/helpers": "./dist/adapter/git-host/helpers.mjs",
      "./adapter/storage": "./dist/adapter/storage.mjs",
      "./capture": "./dist/capture.mjs",
      "./ddl": "./dist/ddl.mjs",
      "./diff": "./dist/diff.mjs",
      "./logger": "./dist/logger.mjs",
      "./paths": "./dist/paths.mjs",
      "./schema": "./dist/schema.mjs",
      "./types": "./dist/types.mjs",
      "./urls": "./dist/urls.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "lint:fix": "nub run lint -- --fix",
    "prepublishOnly": "nub run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.1.5",
    "adm-zip": "^0.6.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.11.0",
    "pino": "^10.3.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "jsr": {
    "runtimeCompat": {
      "node": true,
      "deno": true,
      "bun": true,
      "workerd": false,
      "browser": false
    }
  }
}
