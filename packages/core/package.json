    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "lint:fix": "nub run lint -- --fix",
    "prepublishOnly": "nub run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:flake": "vitest run --repeats=20 --maxWorkers=1 --no-file-parallelism src/utils/map-limit.test.ts src/capture/rediff.test.ts src/models/build.test.ts src/models/design-credentials.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@storyshelf/affected": "workspace:*",
    "@storyshelf/common": "workspace:*",
    "drizzle-orm": "catalog:",
    "pino": "catalog:",
    "unzipper": "0.12.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "catalog:",
    "@types/unzipper": "catalog:",
    "@vitest/coverage-v8": "catalog:",
