    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nodemailer": "^10.2.1",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "storyshelf": {
    "peerSubpaths": {
      "nodemailer": [
        "./adapter/email-sender"
      ]
    }
  }
