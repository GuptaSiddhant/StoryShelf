{
  "name": "@storyshelf/core",
  "version": "0.5.2",
  "description": "StoryShelf core: adapter interfaces, models, capture pipeline, diff, and retention (no HTTP).",
  "keywords": [
    "chromatic-alternative",
    "self-hosted",
    "storybook",
    "visual-regression-testing",
    "visual-testing"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "default": "./dist/index.mjs"
    },
    "./adapter/auth": {
      "source": "./src/adapters/auth.ts",
      "default": "./dist/adapter/auth.mjs"
    },
    "./adapter/capture-queue": {
      "source": "./src/adapters/capture-queue.ts",
      "default": "./dist/adapter/capture-queue.mjs"
    },
    "./adapter/capture-runner": {
      "source": "./src/adapters/capture-runner.ts",
      "default": "./dist/adapter/capture-runner.mjs"
    },
    "./adapter/database": {
      "source": "./src/adapters/database.ts",
      "default": "./dist/adapter/database.mjs"
    },
    "./adapter/git-host": {
      "source": "./src/adapters/git-host/index.ts",
      "default": "./dist/adapter/git-host.mjs"
    },
    "./adapter/git-host/comments": {
      "source": "./src/adapters/git-host/comments.ts",
      "default": "./dist/adapter/git-host/comments.mjs"
    },
    "./adapter/git-host/helpers": {
      "source": "./src/adapters/git-host/helpers.ts",
      "default": "./dist/adapter/git-host/helpers.mjs"
    },
    "./adapter/metadata": {
      "source": "./src/adapters/metadata.ts",
      "default": "./dist/adapter/metadata.mjs"
    },
    "./adapter/setup": {
      "source": "./src/adapters/setup.ts",
      "default": "./dist/adapter/setup.mjs"
    },
    "./adapter/storage": {
      "source": "./src/adapters/storage.ts",
      "default": "./dist/adapter/storage.mjs"
    },
    "./adapter/webhook-events": {
      "source": "./src/adapters/webhook-events.ts",
      "default": "./dist/adapter/webhook-events.mjs"
    },
    "./capture": {
      "source": "./src/capture/index.ts",
      "default": "./dist/capture.mjs"
    },
    "./config": {
      "source": "./src/config.ts",
      "default": "./dist/config.mjs"
    },
    "./diff": {
      "source": "./src/diff/index.ts",
      "default": "./dist/diff.mjs"
    },
    "./logger": {
      "source": "./src/logger.ts",
      "default": "./dist/logger.mjs"
    },
    "./models": {
      "source": "./src/models/index.ts",
      "default": "./dist/models.mjs"
    },
    "./paths": {
      "source": "./src/utils/paths.ts",
      "default": "./dist/paths.mjs"
    },
    "./retention": {
      "source": "./src/retention/purge.ts",
      "default": "./dist/retention.mjs"
    },
    "./schema": {
      "source": "./src/schema/index.ts",
      "default": "./dist/schema.mjs"
    },
    "./test-helpers": {
      "source": "./src/test-helpers/index.ts",
      "default": "./dist/test-helpers.mjs"
    },
    "./types": {
      "source": "./src/types.ts",
      "default": "./dist/types.mjs"
    },
    "./urls": {
      "source": "./src/urls.ts",
      "default": "./dist/urls.mjs"
    },
    "./utils": {
      "source": "./src/utils/index.ts",
      "default": "./dist/utils.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./adapter/auth": "./dist/adapter/auth.mjs",
      "./adapter/capture-queue": "./dist/adapter/capture-queue.mjs",
      "./adapter/capture-runner": "./dist/adapter/capture-runner.mjs",
      "./adapter/database": "./dist/adapter/database.mjs",
      "./adapter/git-host": "./dist/adapter/git-host.mjs",
      "./adapter/git-host/comments": "./dist/adapter/git-host/comments.mjs",
      "./adapter/git-host/helpers": "./dist/adapter/git-host/helpers.mjs",
      "./adapter/metadata": "./dist/adapter/metadata.mjs",
      "./adapter/setup": "./dist/adapter/setup.mjs",
      "./adapter/storage": "./dist/adapter/storage.mjs",
      "./adapter/webhook-events": "./dist/adapter/webhook-events.mjs",
      "./capture": "./dist/capture.mjs",
      "./config": "./dist/config.mjs",
      "./diff": "./dist/diff.mjs",
      "./logger": "./dist/logger.mjs",
      "./models": "./dist/models.mjs",
      "./paths": "./dist/paths.mjs",
      "./retention": "./dist/retention.mjs",
      "./schema": "./dist/schema.mjs",
      "./test-helpers": "./dist/test-helpers.mjs",
      "./types": "./dist/types.mjs",
      "./urls": "./dist/urls.mjs",
      "./utils": "./dist/utils.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "lint:fix": "nub run lint -- --fix",
    "prepublishOnly": "nub run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pino": "catalog:",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "unzipper": "0.12.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/unzipper": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "jsr": {
    "runtimeCompat": {
      "node": true,
      "deno": true,
      "bun": true,
      "workerd": false,
      "browser": false
    }
  }
}