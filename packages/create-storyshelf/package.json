{
  "name": "create-storyshelf",
  "version": "0.14.0",
  "description": "Scaffold a StoryShelf server: npm create storyshelf.",
  "keywords": [
    "create",
    "scaffold",
    "self-hosted",
    "storybook",
    "visual-testing"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/create-storyshelf"
  },
  "bin": {
    "create-storyshelf": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run",
    "prepublishOnly": "nub run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prompts": "^2.4.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
