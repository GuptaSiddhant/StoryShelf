{
  "name": "@storyshelf/db-turso",
  "version": "0.1.0",
  "type": "module",
  "description": "Turso/libSQL database adapter for StoryShelf (@libsql/client + Drizzle).",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt -c ../../.oxfmtrc.json ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "@storyshelf/core": "workspace:*",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
