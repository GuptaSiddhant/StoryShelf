{
  "name": "@storyshelf/git-github",
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub commit status adapter for StoryShelf.",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/storyshelf.git",
    "directory": "packages/git-github"
  },
  "homepage": "https://github.com/GuptaSiddhant/storyshelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/storyshelf/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt -c ../../.oxfmtrc.json ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run",
    "prepublishOnly": "nub run build"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "pino": "catalog:",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@storyshelf/core": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
