{
  "name": "@storyshelf/image",
  "version": "0.12.0",
  "description": "Deprecated: the StoryShelf image engine now lives in @storyshelf/core/diff. This package re-exports it.",
  "keywords": [
    "diff",
    "image",
    "pixelmatch",
    "sharp",
    "storybook",
    "visual-testing"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/image"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "prepublishOnly": "nub run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@storyshelf/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
