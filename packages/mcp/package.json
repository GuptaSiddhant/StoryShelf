{
  "name": "@storyshelf/mcp",
  "version": "0.6.2",
  "description": "StoryShelf MCP server: let AI agents read builds, diffs and AI insights, and comment on reviews.",
  "keywords": [
    "agents",
    "mcp",
    "model-context-protocol",
    "self-hosted",
    "storybook",
    "visual-testing"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "storyshelf-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run",
    "prepublishOnly": "nub run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@storyshelf/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "jsr": false
}
