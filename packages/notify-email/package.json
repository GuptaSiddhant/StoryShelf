{
  "name": "@storyshelf/notify-email",
  "version": "0.5.2",
  "description": "Email notification transport for StoryShelf (SMTP, Mailpit, log, HTTP APIs).",
  "keywords": [
    "notifications",
    "email",
    "smtp",
    "self-hosted",
    "storybook"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/notify-email"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./email": {
      "source": "./src/email.ts",
      "default": "./dist/email.mjs"
    },
    "./http": {
      "source": "./src/http.ts",
      "default": "./dist/http.mjs"
    },
    "./log": {
      "source": "./src/log.ts",
      "default": "./dist/log.mjs"
    },
    "./mailpit": {
      "source": "./src/mailpit.ts",
      "default": "./dist/mailpit.mjs"
    },
    "./smtp": {
      "source": "./src/smtp.ts",
      "default": "./dist/smtp.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./email": "./dist/email.mjs",
      "./http": "./dist/http.mjs",
      "./log": "./dist/log.mjs",
      "./mailpit": "./dist/mailpit.mjs",
      "./smtp": "./dist/smtp.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run",
    "prepublishOnly": "nub run build"
  },
  "dependencies": {
    "@storyshelf/core": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "nodemailer": "^10.0.12"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "nodemailer": "^10.0.12",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "jsr": {
    "runtimeCompat": {
      "node": true,
      "deno": false,
      "browser": false,
      "workerd": false,
      "bun": true
    }
  }
}
