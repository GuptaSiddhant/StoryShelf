{
  "name": "@storyshelf/runner-playwright",
  "version": "0.1.0",
  "type": "module",
  "description": "Pure Playwright CaptureRunner implementation for StoryShelf: renders Storybook screenshots in-process (no db/storage coupling).",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt -c ../../.oxfmtrc.json ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run integration.test.ts"
  },
  "dependencies": {
    "@storyshelf/core": "workspace:*",
    "adm-zip": "^0.6.0",
    "pino": "^10.3.1",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/storage-local": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
