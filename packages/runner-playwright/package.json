{
  "name": "@storyshelf/runner-playwright",
  "version": "0.10.0",
  "description": "Pure Playwright CaptureRunner implementation for StoryShelf: renders Storybook screenshots in-process (no db/storage coupling).",
  "keywords": [
    "playwright",
    "screenshot",
    "self-hosted",
    "storybook",
    "visual-testing"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/runner-playwright"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./remote": {
      "source": "./src/remote/index.ts",
      "default": "./dist/remote/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./remote": "./dist/remote/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack -w",
    "fmt": "vp fmt ./src",
    "lint": "vp lint --type-aware --type-check ./src",
    "test": "vp test run",
    "test:integration": "RUN_INTEGRATION=1 vp test run integration.test.ts passkey.integration.test.ts remote.integration.test.ts",
    "prepublishOnly": "vp run build",
    "test:flake": "vp test run --repeats=20 --maxWorkers=1 --no-file-parallelism src/capture-runner.test.ts src/settle.test.ts src/screenshot.test.ts"
  },
  "dependencies": {
    "@storyshelf/core": "workspace:*",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@storyshelf/app": "workspace:*",
    "@storyshelf/auth": "workspace:*",
    "@storyshelf/db-sqlite": "workspace:*",
    "@storyshelf/storage-local": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "adm-zip": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
