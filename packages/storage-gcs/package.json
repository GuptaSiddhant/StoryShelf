{
  "name": "@storyshelf/storage-gcs",
  "version": "0.10.0",
  "description": "Google Cloud Storage adapter for StoryShelf.",
  "keywords": [
    "gcs",
    "google-cloud-storage",
    "self-hosted",
    "storage",
    "storybook"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/storage-gcs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack -w",
    "fmt": "vp fmt ./src",
    "lint": "vp lint --type-aware --type-check ./src",
    "test": "vp test run",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.13.0",
    "@storyshelf/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
