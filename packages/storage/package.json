{
  "name": "@storyshelf/storage",
  "version": "0.15.1",
  "description": "Storage adapters for StoryShelf: S3-compatible, Google Cloud Storage, Azure Blob Storage and local disk, one subpath each.",
  "keywords": [
    "azure",
    "gcs",
    "r2",
    "s3",
    "self-hosted",
    "storage",
    "storybook"
  ],
  "homepage": "https://github.com/GuptaSiddhant/StoryShelf#readme",
  "bugs": {
    "url": "https://github.com/GuptaSiddhant/StoryShelf/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siddhant Gupta",
    "url": "https://guptasiddhant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuptaSiddhant/StoryShelf.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./azure": {
      "source": "./src/azure/index.ts",
      "default": "./dist/azure/index.mjs"
    },
    "./gcs": {
      "source": "./src/gcs/index.ts",
      "default": "./dist/gcs/index.mjs"
    },
    "./local": {
      "source": "./src/local/index.ts",
      "default": "./dist/local/index.mjs"
    },
    "./s3": {
      "source": "./src/s3/index.ts",
      "default": "./dist/s3/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./azure": "./dist/azure/index.mjs",
      "./gcs": "./dist/gcs/index.mjs",
      "./local": "./dist/local/index.mjs",
      "./s3": "./dist/s3/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "fmt": "oxfmt ./src",
    "lint": "oxlint --type-aware --type-check ./src",
    "test": "vitest run",
    "prepublishOnly": "nub run build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "3.700.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.26.0",
    "@google-cloud/storage": "^7.13.0",
    "@storyshelf/core": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.26.0",
    "@google-cloud/storage": "^7.13.0",
    "@storyshelf/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "storyshelf": {
    "peerSubpaths": {
      "@aws-sdk/client-s3": [
        "./s3"
      ],
      "@aws-sdk/lib-storage": [
        "./s3"
      ],
      "@azure/identity": [
        "./azure"
      ],
      "@azure/storage-blob": [
        "./azure"
      ],
      "@google-cloud/storage": [
        "./gcs"
      ]
    }
  }
}
