{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["config/**", "nub.jsonc"],
  "cacheMaxAge": "7d",
  "cacheMaxSize": "1GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "PUBLISHED_BASE_DOMAIN",
        "STORAGE_S3_BUCKET",
        "STORAGE_S3_ENDPOINT",
        "STORAGE_S3_REGION",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!README.md", "!LICENSE"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "fmt": {
      "outputLogs": "new-only",
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "verify": {
      "dependsOn": ["build", "lint", "test"]
    },
    "audit": {
      "cache": false
    },
    "website#build": {
      "cache": false
    }
  }
}
